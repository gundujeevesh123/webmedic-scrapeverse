# WebMedic / ScrapeVerse configuration
# Copy to `.env` and fill in real values as needed.

# Acquisition provider: "fixture" (default, deterministic) or "brightdata"
ACQUISITION_PROVIDER=fixture

# Bright Data configuration (Web Unlocker / Scraper Studio proxy)
# Only used when ACQUISITION_PROVIDER=brightdata
BRIGHTDATA_ZONE=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=33335

# Database
DATABASE_URL=sqlite:///data/webmedic.sqlite

# Fixture server (used in demos)
FIXTURE_BASE_URL=http://127.0.0.1:8765

# Health thresholds
HEALTH_HEALTHY_THRESHOLD=0.90
HEALTH_WARNING_THRESHOLD=0.70
